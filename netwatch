def cmd_banner(icon, cmd, color=C):
    pad = 53 - len(f"  {icon}  N E T W A T C H  \u00b7  {cmd}  ")
    line = "\u2500" * 55
    title = f"  {icon}  N E T W A T C H  \u00b7  {cmd}{' ' * max(pad, 1)}"
    return f"\n{color}\u256d{line}\u256e\n\u2502{title}\u2502\n\u2570{line}\u256f{RST}\n"

def print_banner(cmd):
    banners = {
        "status":        lambda: cmd_banner("\u25c9", "status",        C),
        "devices":       lambda: cmd_banner("\u25a6", "devices",        P),
        "scan":          lambda: cmd_banner("\u25ce", "scan",           G),
        "logs":          lambda: cmd_banner("\u2261", "logs",           OR),
        "label":         lambda: cmd_banner("\u25c8", "label",          Y),
        "trust":         lambda: cmd_banner("\u25c8", "trust",          Y),
        "untrust":       lambda: cmd_banner("\u25c8", "untrust",        R),
        "history":       lambda: cmd_banner("\u23f2", "history",        DIM),
        "config":        lambda: cmd_banner("\u2699", "config",         C),
        "test-telegram": lambda: cmd_banner("\u2708", "test-telegram",  B),
        "help":          lambda: BANNER_BIG,
        "install":       lambda: BANNER_BIG,
    }
    fn = banners.get(cmd)
    if fn:
        print(fn())

# ── Helpers ───────────────────────────────────────────────
def require_root():
    if os.geteuid() != 0:
        print(c(R, "✗ This command needs root. Run: sudo netwatch " + " ".join(sys.argv[1:])))
        sys.exit(1)

def load_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default if default is not None else {}

def save_json(path, data):
    with open(path, "w") as f:
        json.dump(data, f, indent=2, default=str)

def systemctl(action):
    result = subprocess.run(
        ["systemctl", action, SERVICE],
        capture_output=True, text=True
    )
    return result.returncode == 0, result.stderr.strip()

def service_status() -> str:
    result = subprocess.run(
        ["systemctl", "is-active", SERVICE],
        capture_output=True, text=True
    )
    return result.stdout.strip()

def check_install():
    if not INSTALL_DIR.exists() or not (INSTALL_DIR / "network_monitor.py").exists():
        print(c(R, "✗ NetWatch not installed. Run: sudo netwatch install"))
        sys.exit(1)


# ── Commands ──────────────────────────────────────────────

def cmd_start(args):
    require_root()
    check_install()
    print_banner("status")
    ok, err = systemctl("start")
    if ok:
        print(c(G, "✓ NetWatch started."))
        cmd_status(args)
    else:
        print(c(R, f"✗ Failed to start: {err}"))

def cmd_stop(args):
    require_root()
    ok, err = systemctl("stop")
    print(c(Y, "◼ NetWatch stopped.") if ok else c(R, f"✗ {err}"))

def cmd_restart(args):
    require_root()
    check_install()
    ok, err = systemctl("restart")
    print(c(G, "↺ NetWatch restarted.") if ok else c(R, f"✗ {err}"))

def cmd_status(args):
    check_install()
    print_banner("status")
    state = service_status()
    state_colored = c(G, "● running") if state == "active" else c(R, f"● {state}")
    print(f"\n  Service : {state_colored}")

    # uptime from systemctl show
    r = subprocess.run(
        ["systemctl", "show", SERVICE, "--property=ActiveEnterTimestamp"],
        capture_output=True, text=True
    )
    for line in r.stdout.splitlines():
        if "ActiveEnterTimestamp=" in line:
            ts = line.split("=", 1)[1].strip()
            print(f"  Since   : {c(DIM, ts)}")

    devices = load_json(DEVICES_FILE, {})
    history = load_json(HISTORY_FILE, [])
    last_scan = history[-1] if history else None

    print(f"  Known   : {c(W, str(len(devices)))} device(s)")
    if last_scan:
        print(f"  Last scan: {c(DIM, last_scan.get('timestamp','?'))}  —  "
              f"{c(W, str(last_scan.get('total_found', '?')))} online")

    if devices:
        print(f"\n  {'MAC':<20} {'IP':<16} {'Label / Hostname':<26} {'Last Seen'}")
        print(f"  {'─'*85}")
        for mac, d in devices.items():
            label = d.get("label") or d.get("hostname") or c(DIM, "—")
            trusted = c(G, "✓") if d.get("trusted") else c(Y, "?")
            print(f"  {trusted} {mac:<20} {d.get('ip','?'):<16} {label:<26} {c(DIM, d.get('last_seen','?'))}")
    print()

def cmd_logs(args):
    check_install()
    print_banner("logs")
    n = getattr(args, "lines", 50)
    if getattr(args, "follow", False):
        print(c(C, f"  Following NetWatch logs (Ctrl+C to exit)...\n"))
        os.execlp("journalctl", "journalctl", "-u", SERVICE, "-f", "--no-pager")
    else:
        subprocess.run(["journalctl", "-u", SERVICE, "-n", str(n), "--no-pager"])

def cmd_scan(args):
    require_root()
    check_install()
    print_banner("scan")
    cfg = load_json(CONFIG_FILE, {})
    network = cfg.get("network_range", "192.168.1.0/24")
    print(c(C, f"\n  Scanning {network} ...\n"))
    subprocess.run(["nmap", "-sn", "-T4", network])
    print()

def cmd_devices(args):
    check_install()
    print_banner("devices")
    devices = load_json(DEVICES_FILE, {})
    if not devices:
        print(c(Y, "  No devices in registry yet. Run: sudo netwatch scan"))
        return

    print(f"\n  {c(W, 'All known devices')} ({len(devices)} total)\n")
    print(f"  {'#':<4} {'Status':<8} {'IP':<16} {'MAC':<20} {'Vendor':<22} {'OS':<30} {'Label'}")
    print(f"  {'─'*115}")

    history = load_json(HISTORY_FILE, [])
    online_ips = set()
    if history:
        for d in history[-1].get("devices", []):
            online_ips.add(d.get("ip"))

    for i, (mac, d) in enumerate(devices.items(), 1):
        is_online = d.get("ip") in online_ips
        status    = c(G, "online ") if is_online else c(DIM, "offline")
        label     = d.get("label") or c(DIM, "—")
        os_g      = d.get("os_guess") or c(DIM, "—")
        vendor    = d.get("vendor") or c(DIM, "Unknown")
        print(f"  {i:<4} {status}  {d.get('ip','?'):<16} {mac:<20} {vendor:<22} {os_g:<30} {label}")
    print()

def cmd_label(args):
    require_root()
    check_install()
    print_banner("label")
    mac   = args.mac.upper()
    label = args.name
    devices = load_json(DEVICES_FILE, {})
    if mac not in devices:
        print(c(R, f"  ✗ MAC {mac} not found in registry."))
        print(c(DIM, "  Run 'netwatch devices' to see known MACs."))
        sys.exit(1)
    devices[mac]["label"]   = label
    devices[mac]["trusted"] = True
    save_json(DEVICES_FILE, devices)
    print(c(G, f"  ✓ {mac}  →  \"{label}\"  (marked trusted)"))

def cmd_trust(args):
    require_root()
    check_install()
    print_banner("trust")
    mac = args.mac.upper()
    cfg = load_json(CONFIG_FILE, {})
    trusted = [m.upper() for m in cfg.get("trusted_macs", [])]
    if mac not in trusted:
        trusted.append(mac)
        cfg["trusted_macs"] = trusted
        save_json(CONFIG_FILE, cfg)
        print(c(G, f"  ✓ {mac} added to trusted list in config."))
    else:
        print(c(Y, f"  {mac} is already trusted."))

def cmd_untrust(args):
    require_root()
    check_install()
    print_banner("untrust")
    mac = args.mac.upper()
    cfg = load_json(CONFIG_FILE, {})
    trusted = [m.upper() for m in cfg.get("trusted_macs", [])]
    if mac in trusted:
        trusted.remove(mac)
        cfg["trusted_macs"] = trusted
        save_json(CONFIG_FILE, cfg)
        print(c(Y, f"  ✓ {mac} removed from trusted list."))
    else:
        print(c(DIM, f"  {mac} was not in trusted list."))

def cmd_history(args):
    check_install()
    print_banner("history")
    history = load_json(HISTORY_FILE, [])
    if not history:
        print(c(Y, "  No scan history yet."))
        return
    n = getattr(args, "count", 10)
    recent = history[-n:]
    print(f"\n  {c(W, f'Last {len(recent)} scans')}\n")
    print(f"  {'Timestamp':<22} {'Online':>8} {'New':>6}")
    print(f"  {'─'*42}")
    for h in recent:
        new_count = h.get("new_count", 0)
        new_str   = c(R, f"+{new_count}") if new_count > 0 else c(DIM, "  0")
        print(f"  {h.get('timestamp','?'):<22} {h.get('total_found','?'):>8}    {new_str}")
    print()

def cmd_test_telegram(args):
    check_install()
    print_banner("test-telegram")
    cfg = load_json(CONFIG_FILE, {})
    tg  = cfg.get("alert", {}).get("telegram", {})
    if not tg.get("enabled") or not tg.get("bot_token") or not tg.get("chat_id"):
        print(c(Y, "  Telegram is not configured or not enabled in config.json"))
        return
    import urllib.request, urllib.parse
    token   = tg["bot_token"]
    chat_id = tg["chat_id"]
    msg     = f"✅ NetWatch test — connection confirmed at {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
    url     = f"https://api.telegram.org/bot{token}/sendMessage"
    data    = urllib.parse.urlencode({"chat_id": chat_id, "text": msg}).encode()
    try:
        with urllib.request.urlopen(urllib.request.Request(url, data=data), timeout=10) as r:
            if r.getcode() == 200:
                print(c(G, "  ✓ Telegram test message sent! Check your phone."))
            else:
                print(c(R, f"  ✗ Telegram returned HTTP {r.getcode()}"))
    except Exception as e:
        print(c(R, f"  ✗ Telegram test failed: {e}"))

