def cmd_install(args):
    require_root()
    print_banner("install")
    src = Path(__file__).parent

    # Check deps
    print(c(B, "[1/4]"), "Checking dependencies...")
    for dep in ["nmap", "python3"]:
        r = subprocess.run(["which", dep], capture_output=True)
        if r.returncode == 0:
            print(f"  {dep}: {c(G,'✓')}")
        else:
            print(f"  {dep}: {c(R,'missing')} — installing...")
            subprocess.run(["pacman", "-S", "--noconfirm", dep])

    print(c(B, "[2/4]"), f"Creating {INSTALL_DIR} ...")
    INSTALL_DIR.mkdir(parents=True, exist_ok=True)

    print(c(B, "[3/4]"), "Copying files...")
    import shutil
    for fname in ["network_monitor.py", "netwatch"]:
        src_f = src / fname
        if src_f.exists():
            shutil.copy2(src_f, INSTALL_DIR / fname)
    if not (INSTALL_DIR / "config.json").exists():
        cfg_src = src / "config.json"
        if cfg_src.exists():
            shutil.copy2(cfg_src, INSTALL_DIR / "config.json")

    # Install CLI to PATH
    cli_dest = Path("/usr/local/bin/netwatch")
    shutil.copy2(Path(__file__), cli_dest)
    cli_dest.chmod(0o755)
    print(f"  CLI installed → {c(G, str(cli_dest))}")

    # Systemd service
    print(c(B, "[4/4]"), "Installing systemd service...")
    svc_src = src / "netwatch.service"
    if svc_src.exists():
        shutil.copy2(svc_src, "/etc/systemd/system/netwatch.service")
        subprocess.run(["systemctl", "daemon-reload"])
        subprocess.run(["systemctl", "enable", SERVICE])

    print(f"\n  {c(G,'✓ Installation complete!')}\n")
    print(f"  {Y}Next:{RST}")
    print(f"    netwatch config              — view current config")
    print(f"    sudo netwatch start          — start the daemon")
    print(f"    sudo netwatch label <MAC> <name>  — label a device")
    print()

def cmd_uninstall(args):
    require_root()
    print(c(Y, "  Stopping and removing NetWatch service..."))
    systemctl("stop")
    systemctl("disable")
    subprocess.run(["systemctl", "stop", "traffwatch"], capture_output=True)
    subprocess.run(["systemctl", "disable", "traffwatch"], capture_output=True)
    subprocess.run(["rm", "-f", "/etc/systemd/system/netwatch.service"])
    subprocess.run(["rm", "-f", "/etc/systemd/system/traffwatch.service"])
    subprocess.run(["systemctl", "daemon-reload"])
    subprocess.run(["rm", "-f", "/usr/local/bin/netwatch"])
    print(c(G, "  ✓ Service removed. Data at /opt/netwatch is preserved."))
    print(c(DIM, "  To remove data: sudo rm -rf /opt/netwatch"))


