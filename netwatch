def cmd_traffic_watch(args):
    """Set a time limit for a device+category."""
    require_root()
    check_install()
    print_banner("traffic")
    mac      = args.mac.upper()
    category = args.category.capitalize()
    minutes  = args.minutes
    devices  = load_json(DEVICES_FILE, {})
    tcfg     = load_json(TRAFF_CFG, {})

    if mac not in devices:
        print(c(R, f"  ✗ MAC {mac} not found. Run 'netwatch devices'."))
        return

    label = devices[mac].get("label") or devices[mac].get("hostname") or mac
    watched = tcfg.setdefault("watched_devices", {})
    watched.setdefault(mac, {"label": label, "limits": {}})
    watched[mac]["label"] = label
    watched[mac]["limits"][category] = int(minutes)
    save_json(TRAFF_CFG, tcfg)
    print(c(G, f"  ✓ {label}  →  {category}  limit set to {minutes} min/day"))
    print(c(DIM, "  Restart traffwatch to apply: sudo netwatch traffic-restart\n"))

def cmd_traffic_unwatch(args):
    """Remove a time limit for a device+category."""
    require_root()
    check_install()
    mac      = args.mac.upper()
    category = args.category.capitalize() if hasattr(args, "category") and args.category else None
    tcfg     = load_json(TRAFF_CFG, {})
    watched  = tcfg.get("watched_devices", {})

    if mac not in watched:
        print(c(Y, f"  {mac} is not being watched."))
        return

    if category:
        watched[mac]["limits"].pop(category, None)
        print(c(Y, f"  ✓ Removed {category} limit for {mac}"))
    else:
        watched.pop(mac, None)
        print(c(Y, f"  ✓ Removed all limits for {mac}"))

    save_json(TRAFF_CFG, tcfg)

def cmd_traffic_live(args):
    """
    Live updating dashboard — shows what each device is doing RIGHT NOW.
    Tails the traffwatch journal and renders a live per-device activity board.
    Refreshes every 3 seconds. Press Ctrl+C to exit.
    """
    import time
    import re
    import shutil
    import threading
    from collections import defaultdict, deque
    from datetime import datetime

    check_install()

    # Strip ANSI codes to get the visible display length of a string
    _ANSI_RE = re.compile(r'\033\[[^m]*m')
    def visible_len(s: str) -> int:
        return len(_ANSI_RE.sub('', s))

    def ansi_ljust(s: str, width: int) -> str:
        pad = max(0, width - visible_len(s))
        return s + ' ' * pad

    # ANSI helpers
    CLEAR    = "\033[2J\033[H"
    HIDE_CUR = "\033[?25l"
    SHOW_CUR = "\033[?25h"
    BOLD_W   = "\033[1;37m"

    CAT_ICON = {
        "Video":     "▶",
        "Gaming":    "🎮" if shutil.get_terminal_size().columns > 40 else "G",
        "Social":    "◈",
        "Adult":     "⚠",
        "Gambling":  "⚠",
        "Education": "✦",
        "Music":     "♪",
        "Comms":     "☎",
        "Shopping":  "◉",
        "Other":     "·",
    }
    CAT_COL = {
        "Video":     C,
        "Gaming":    OR,
        "Social":    P,
        "Adult":     R,
        "Gambling":  R,
        "Education": G,
        "Music":     B,
        "Comms":     DIM,
        "Shopping":  DIM,
        "Other":     DIM,
    }

    # Recent activity window per device: (ip) -> deque of (timestamp, category, service)
    recent: dict = defaultdict(lambda: deque(maxlen=12))
    # Last seen service per device for the "NOW" indicator
    last_seen: dict = {}   # ip -> (category, service, timestamp)

    # ip_label is refreshed every render so label changes in known_devices.json
    # are picked up without restarting the dashboard
    _label_cache: dict = {}
    _label_cache_time: list = [0.0]

    def get_label(ip: str) -> str:
        now = time.time()
        if now - _label_cache_time[0] > 10:
            devs = load_json(DEVICES_FILE, {})
            _label_cache.clear()
            for mac, d in devs.items():
                ip_d = d.get("ip")
                if ip_d:
                    _label_cache[ip_d] = d.get("label") or d.get("hostname") or mac
            _label_cache_time[0] = now
        return _label_cache.get(ip, ip)

    def _fresh_devices() -> dict:
        return load_json(DEVICES_FILE, {})

    def time_ago(ts: float) -> str:
        diff = time.time() - ts
        if diff < 5:    return f"{G}just now{RST}"
        if diff < 60:   return f"{c(DIM, str(int(diff)) + 's ago')}"
        if diff < 3600: return f"{c(DIM, str(int(diff//60)) + 'm ago')}"
        return f"{c(DIM, str(int(diff//3600)) + 'h ago')}"

    def bar(mins: int, limit: int = 0, width: int = 20) -> str:
        if limit:
            pct  = min(1.0, mins / limit)
            fill = int(pct * width)
            col  = G if pct < 0.6 else (Y if pct < 0.9 else R)
            return f"{col}{'█' * fill}{'░' * (width - fill)}{RST} {mins}/{limit}m"
        fill = min(width, mins // 3)
        return f"{C}{'█' * fill}{RST}"

    def render(recent, last_seen, tcfg):
        lines = []
        now_str = datetime.now().strftime("%H:%M:%S")
        w = shutil.get_terminal_size().columns

        # Use ansi_ljust so the box border aligns correctly despite ANSI codes
        lines.append(f"\n{C}╭{'─' * (w-2)}╮{RST}")
        title = f"  ◉  N E T W A T C H  ·  live traffic   {DIM}{now_str}{RST}"
        lines.append(f"{C}│{RST}{ansi_ljust(title, w-2)}{C}│{RST}")
        lines.append(f"{C}╰{'─' * (w-2)}╯{RST}")
        lines.append(f"  {DIM}Ctrl+C to exit   •   updates every 3s{RST}\n")

        watched_devs = tcfg.get("watched_devices", {})
        devs = _fresh_devices()
        mac_for_ip = {d.get("ip"): mac for mac, d in devs.items()}

        if not last_seen:
            lines.append(f"  {DIM}Waiting for traffic...{RST}")
            lines.append(f"  {DIM}Make sure devices are actively using the internet.{RST}\n")
        else:
            for ip, (cat, svc, ts) in sorted(last_seen.items(),
                                              key=lambda x: -x[1][2]):
                label  = get_label(ip)
                col    = CAT_COL.get(cat, DIM)
                icon   = CAT_ICON.get(cat, "·")
                status = f"{G}● LIVE{RST}" if time.time() - ts < 10 else f"{Y}○ {time_ago(ts)}{RST}"

                lines.append(f"  {ansi_ljust(BOLD_W + label + RST, 24)}  {status}")
                lines.append(f"    {col}{icon}  {cat:<10}  {W}{svc}{RST}")

                trail = list(recent[ip])[-6:]
                if trail:
                    trail_str = "  ".join(
                        f"{CAT_COL.get(c2,DIM)}{s2}{RST}"
                        for _, c2, s2 in reversed(trail)
                    )
                    lines.append(f"    {DIM}recent:{RST}  {trail_str}")

                mac = mac_for_ip.get(ip)
                if mac and mac in watched_devs:
                    activity = load_json(ACTIVITY_FILE, {})
                    from datetime import date as _date
                    today = _date.today().isoformat()
                    limits = watched_devs[mac].get("limits", {})
                    if limits:
                        parts = []
                        for lcat, lmins in limits.items():
                            cats = activity.get(today, {}).get(ip, {}).get(lcat, {})
                            used = max(1, int(sum(cats.values()) / 2))
                            parts.append(
                                f"{CAT_COL.get(lcat,DIM)}{lcat}{RST}: "
                                f"{bar(used, lmins, 12)}"
                            )
                        lines.append(f"    {DIM}limits:{RST}  {'   '.join(parts)}")

                lines.append("")

        return "\n".join(lines)

    # Start tailing traffwatch journal for live events
    tail_cmd = ["journalctl", "-u", "traffwatch", "-f", "-n", "0",
                "--no-pager", "--output=short-unix"]

    print(HIDE_CUR, end="", flush=True)
    try:
        proc = subprocess.Popen(
            tail_cmd, stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL, text=True, bufsize=1
        )

        tcfg = load_json(TRAFF_CFG, {})
        last_render = 0.0
        _lock = threading.Lock()
        _tail_error: list = [None]

        log_path = INSTALL_DIR / "traffwatch.log"

        # Pattern: "192.168.1.x → Service (Category) domain"
        _TRAFFIC_RE = re.compile(
            r"(\d+\.\d+\.\d+\.\d+)\s+→\s+(.+?)\s+\((.+?)\)\s+(\S+)"
        )

        def tail_logfile():
            """Tail traffwatch.log for domain hit events."""
            backoff = 0.1
            while True:
                try:
                    # Explicit UTF-8 — the log is always written with utf-8 encoding
                    with open(log_path, "r", encoding="utf-8") as f:
                        f.seek(0, 2)   # jump to end; only show new events
                        backoff = 0.1
                        while True:
                            line = f.readline()
                            if not line:
                                time.sleep(0.1)
                                continue
                            m = _TRAFFIC_RE.search(line)
                            if m:
                                ip, svc, cat, _ = m.groups()
                                ts = time.time()
                                with _lock:
                                    recent[ip].append((ts, cat, svc))
                                    last_seen[ip] = (cat, svc, ts)
                except FileNotFoundError:
                    _tail_error[0] = f"log not found: {log_path}"
                    time.sleep(5)
                except Exception as exc:
                    _tail_error[0] = str(exc)
                    time.sleep(backoff)
                    backoff = min(backoff * 2, 10)

        def parse_journal_lines():
            """Journal fallback — catches entries before log file is ready."""
            _J_RE = re.compile(
                r"(\d+\.\d+\.\d+\.\d+)\s+→\s+(.+?)\s+\((.+?)\)"
            )
            for raw in proc.stdout:
                m = _J_RE.search(raw)
                if m:
                    ip, svc, cat = m.groups()
                    ts = time.time()
                    with _lock:
                        recent[ip].append((ts, cat, svc))
                        last_seen[ip] = (cat, svc, ts)

        t1 = threading.Thread(target=tail_logfile,        daemon=True)
        t2 = threading.Thread(target=parse_journal_lines, daemon=True)
        t1.start()
        t2.start()

        first = True
        while True:
            now = time.time()
            if now - last_render >= 3:
                tcfg = load_json(TRAFF_CFG, {})
                with _lock:
                    output = render(dict(recent), dict(last_seen), tcfg)
                # Append tail-error hint if the log thread hit a problem
                err = _tail_error[0]
                if err:
                    output += f"\n  {R}⚠ log tail error: {err}{RST}\n"
                if first:
                    print(CLEAR, end="")
                    first = False
                else:
                    line_count = output.count("\n") + 1
                    print(f"\033[{line_count}A\033[J", end="")
                print(output, end="", flush=True)
                last_render = now
            time.sleep(0.2)

    except KeyboardInterrupt:
        pass
    finally:
        print(SHOW_CUR)
        try:
            proc.terminate()
        except Exception:
            pass
        print(f"\n{c(DIM, '  TraffWatch live view closed.')}\n")


