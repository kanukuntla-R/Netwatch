ACTIVITY_FILE = INSTALL_DIR / "activity_log.json"
TRAFF_CFG     = INSTALL_DIR / "traffic_config.json"
TRAFF_SVC     = "traffwatch"

CAT_COLORS = {
    "Video":     C,
    "Gaming":    OR,
    "Social":    P,
    "Adult":     R,
    "Gambling":  R,
    "Education": G,
    "Music":     B,
    "Comms":     DIM,
    "Shopping":  DIM,
    "Other":     DIM,
}

def cmd_traffic(args):
    """Show today's activity for all devices."""
    check_install()
    print_banner("traffic")
    from datetime import date as _date
    today    = _date.today().isoformat()
    activity = load_json(ACTIVITY_FILE, {})
    day_data = activity.get(today, {})
    devices  = load_json(DEVICES_FILE, {})
    ip_label = {d.get("ip"): (d.get("label") or d.get("hostname") or mac)
                for mac, d in devices.items()}

    if not day_data:
        print(c(Y, "  No activity recorded today yet."))
        print(c(DIM, "  Make sure traffwatch is running: sudo netwatch traffic-start\n"))
        return

    print(f"  {c(W, 'Today — ' + today)}\n")
    for ip, cats in sorted(day_data.items()):
        label = ip_label.get(ip, ip)
        print(f"  {c(W, label)}  {c(DIM, ip)}")
        for cat, services in sorted(cats.items(), key=lambda x: -sum(x[1].values())):
            hits     = sum(services.values())
            est_mins = max(1, int(hits / 2))
            top_svc  = max(services, key=services.get)
            col      = CAT_COLORS.get(cat, DIM)
            bar_len  = min(30, est_mins // 2)
            bar      = "█" * bar_len
            print(f"    {col}{cat:<10}{RST}  {c(W, top_svc):<24}  ~{est_mins:>3} min  {col}{bar}{RST}")
        print()

def cmd_traffic_activity(args):
    """Show activity for a specific device."""
    check_install()
    print_banner("traffic")
    from datetime import date as _date
    target_mac = args.mac.upper() if hasattr(args, "mac") and args.mac else None
    days       = getattr(args, "days", 1)
    activity   = load_json(ACTIVITY_FILE, {})
    devices    = load_json(DEVICES_FILE, {})

    target_ip  = None
    label      = target_mac
    for mac, d in devices.items():
        if mac == target_mac:
            target_ip = d.get("ip")
            label = d.get("label") or d.get("hostname") or mac
            break

    if not target_ip:
        print(c(R, f"  ✗ MAC {target_mac} not found. Run 'netwatch devices' to see MACs."))
        return

    print(f"  Activity for {c(W, label)}  {c(DIM, target_ip)}  (last {days} day(s))\n")

    from datetime import timedelta
    today = _date.today()
    for i in range(days - 1, -1, -1):
        check_date = (today - timedelta(days=i)).isoformat()
        day_data   = activity.get(check_date, {}).get(target_ip, {})
        print(f"  {c(W, check_date)}")
        if not day_data:
            print(c(DIM, "    No activity\n"))
            continue
        for cat, services in sorted(day_data.items(), key=lambda x: -sum(x[1].values())):
            hits     = sum(services.values())
            est_mins = max(1, int(hits / 2))
            col      = CAT_COLORS.get(cat, DIM)
            print(f"    {col}{cat:<10}{RST}  ~{est_mins} min")
            for svc, count in sorted(services.items(), key=lambda x: -x[1]):
                print(f"      {c(DIM, '·')}  {svc:<24}  {c(DIM, str(count) + ' hits')}")
        print()

def cmd_traffic_limits(args):
    """Show or set time limits for watched devices."""
    check_install()
    print_banner("traffic")
    tcfg    = load_json(TRAFF_CFG, {})
    watched = tcfg.get("watched_devices", {})
    devices = load_json(DEVICES_FILE, {})

    if not watched:
        print(c(Y, "  No devices being watched yet."))
        print(c(DIM, "  Add one: sudo netwatch traffic-watch <MAC> <Category> <minutes>"))
        print(c(DIM, "  Example: sudo netwatch traffic-watch 26:8D:B1:2F:EC:C2 Gaming 60\n"))
        return

    print(f"  {c(W, 'Watched devices and time limits')}\n")
    for mac, dcfg in watched.items():
        d     = devices.get(mac, {})
