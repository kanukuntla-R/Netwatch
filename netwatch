def cmd_traffic_install(args):
    """Install traffwatch service + tshark."""
    require_root()
    import shutil
    src = Path(__file__).parent

    print(c(B, "[1/3]"), "Checking tshark...")
    if not shutil.which("tshark"):
        print("  Installing wireshark-cli...")
        subprocess.run(["pacman", "-S", "--noconfirm", "wireshark-cli"])
    else:
        print(f"  tshark: {c(G,'✓')}")

    print(c(B, "[2/3]"), "Copying traffic_monitor.py ...")
    src_f = src / "traffic_monitor.py"
    if src_f.exists():
        shutil.copy2(src_f, INSTALL_DIR / "traffic_monitor.py")
        print(f"  {c(G,'✓')} Copied to {INSTALL_DIR}/traffic_monitor.py")
    else:
        print(c(R, "  ✗ traffic_monitor.py not found in source dir."))
        return

    print(c(B, "[3/3]"), "Installing systemd service...")
    svc_src = src / "traffwatch.service"
    if svc_src.exists():
        shutil.copy2(svc_src, "/etc/systemd/system/traffwatch.service")
        subprocess.run(["systemctl", "daemon-reload"])
        subprocess.run(["systemctl", "enable", TRAFF_SVC])
        print(f"  {c(G,'✓')} Service enabled.")

    print(f"\n  {c(G,'✓ TraffWatch installed!')}\n")
    print(f"  {Y}Next steps:{RST}")
    print(f"    sudo netwatch traffic-start")
    print(f"    sudo netwatch traffic-watch <MAC> Gaming 60")
    print(f"    sudo netwatch traffic-watch <MAC> Video 90")
    print(f"    netwatch traffic              — view today's activity")
    print()


