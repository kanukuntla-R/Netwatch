[Unit]
Description=NetWatch – Home Network Monitor
Documentation=https://github.com/yourname/netwatch
After=network-online.target
Wants=network-online.target

[Service]
# Run as root so nmap can detect MACs and OS fingerprints
User=root
Group=root

WorkingDirectory=/opt/netwatch
ExecStart=/usr/bin/python3 /opt/netwatch/network_monitor.py

# Restart on failure (but not on clean exit)
Restart=on-failure
RestartSec=30

# Logging goes to journal AND the local log file in WorkingDirectory
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netwatch

# Resource limits (nmap is CPU-light; scan every 60s is gentle)
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
